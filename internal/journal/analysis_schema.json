{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "segments"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "batch_id": {
      "type": "string"
    },
    "segments": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "summary",
          "evidence"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "工作",
              "学习",
              "沟通",
              "其他"
            ]
          },
          "object": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "task_id": {
            "type": "string"
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 8
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 12,
            "minItems": 1
          },
          "uncertainties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 8
          }
        }
      }
    }
  }
}
